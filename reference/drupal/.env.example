# Tribune Desk integration. Names only: put values in the server environment.
# Signing secret of the delivery webhook (whsec_...), from your Tribune Desk contact.
TD_WEBHOOK_SECRET=
# API token with articles:write (and articles:read), tdcms_..., from your Tribune Desk contact.
TD_CMS_TOKEN=
# Tribune Desk API base. Leave empty in production (https://api.tribunedesk.com).
TD_API_BASE=
# Public base URL of this site. Defaults to https://news.example.com; set it for local work.
TD_SITE_URL=
