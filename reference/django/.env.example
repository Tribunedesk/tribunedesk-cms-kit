# Tribune Desk integration. Names only: put the values into the server's environment.
# Public address of the blog, used for permalinks and "Edit in CMS" links.
SITE_URL=
# Webhook signing secret (whsec_...), from your Tribune Desk contact.
TD_WEBHOOK_SECRET=
# API token (tdcms_...) with articles:write, for the link back.
TD_CMS_TOKEN=
# API address; leave empty for production (https://api.tribunedesk.com), or the local mock.
TD_API_BASE=
